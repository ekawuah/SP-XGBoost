    "sampler = optuna.samplers.TPESampler(\n",
    "    seed=OPTUNA_SEED\n",
    ")\n",
    "\n",
    "study = optuna.create_study(\n",
    "    direction=\"maximize\",\n",
    "    sampler=sampler,\n",
    "    study_name=\"SP_XGBoost_ROC_AUC\"\n",
    ")\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"OPTUNA STUDY CONFIGURATION\")\n",
