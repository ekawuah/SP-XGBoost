    "#Cell 8 — Configure Optuna study\n",
    "#50 trials for this dataset.That gives you a meaningful tuning budget \n",
    "# without making the notebook unnecessarily expensive\n",
    "# ============================================================\n",
    "# OPTUNA STUDY CONFIGURATION\n",
    "# ============================================================\n",
    "\n",
    "N_TRIALS = 50\n",
    "OPTUNA_SEED = 42\n",
